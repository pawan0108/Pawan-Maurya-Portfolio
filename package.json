{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:content": "node scripts/validate-content.mjs",
    "check": "npm run lint && npm run check:content && npm run format:check && npm run build && npm run check:release",
    "test:browser": "playwright test",
    "check:all": "npm run check && npm run test:browser",
    "test:production": "playwright test --config playwright.production.config.js",
    "audit:performance": "node scripts/audit-performance.mjs",
    "test:release": "node --test scripts/__tests__/release.test.mjs",
    "check:release": "npm run test:release && node scripts/validate-release.mjs",
    "generate:sharing": "node scripts/generate-sharing-assets.mjs",
    "check:subpath": "node scripts/check-subpath-release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "chrome-launcher": "^1.2.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lighthouse": "^13.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": "24.x"
  }
}
